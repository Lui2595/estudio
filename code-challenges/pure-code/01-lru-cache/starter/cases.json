{
  "cases": [
    {
      "name": "classic",
      "ops": [
        ["LRUCache", 2],
        ["put", 1, 1],
        ["put", 2, 2],
        ["get", 1],
        ["put", 3, 3],
        ["get", 2],
        ["put", 4, 4],
        ["get", 1],
        ["get", 3],
        ["get", 4]
      ],
      "expected": [1, -1, -1, 3, 4]
    },
    {
      "name": "capacity_one",
      "ops": [
        ["LRUCache", 1],
        ["put", 1, 10],
        ["get", 1],
        ["put", 2, 20],
        ["get", 1],
        ["get", 2]
      ],
      "expected": [10, -1, 20]
    },
    {
      "name": "update_existing",
      "ops": [
        ["LRUCache", 2],
        ["put", 1, 1],
        ["put", 2, 2],
        ["put", 1, 9],
        ["put", 3, 3],
        ["get", 2],
        ["get", 1],
        ["get", 3]
      ],
      "expected": [-1, 9, 3]
    },
    {
      "name": "get_refreshes_recency",
      "ops": [
        ["LRUCache", 2],
        ["put", 1, 1],
        ["put", 2, 2],
        ["get", 1],
        ["put", 3, 3],
        ["get", 1],
        ["get", 2],
        ["get", 3]
      ],
      "expected": [1, 1, -1, 3]
    },
    {
      "name": "empty_gets",
      "ops": [
        ["LRUCache", 3],
        ["get", 99],
        ["get", 1]
      ],
      "expected": [-1, -1]
